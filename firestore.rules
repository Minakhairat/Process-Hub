rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Pure token-based admin check (safe for allow list queries - zero get/exists calls)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'minakhairat1@gmail.com';
    }

    // Full admin check for single-doc get and write operations
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function callerEmailKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9_-]', '_');
    }

    function hasInvitedRecord() {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && exists(/databases/$(database)/documents/invitedUsers/$(callerEmailKey()));
    }

    function invitedRecordData() {
      return get(/databases/$(database)/documents/invitedUsers/$(callerEmailKey())).data;
    }

    // Approved user check for single-doc get and write operations (never used inside allow list)
    function isApprovedUser() {
      return isAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ('approvalStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved'
        && ('profileCompleted' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileCompleted == true
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Helpers (Blueprint-Synchronized)
    // -------------------------------------------------------------------------
    function isValidAppItem(data) {
      return data.keys().hasAll([
        'id', 'title', 'titleAr', 'description', 'url', 'category',
        'iconType', 'iconName', 'iconUrl', 'accentColor', 'order',
        'isActive', 'featured', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'title', 'titleAr', 'description', 'url', 'category',
        'iconType', 'iconName', 'iconUrl', 'accentColor', 'order',
        'isActive', 'featured', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.id.size() >= 2 && data.id.size() <= 64
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
      && data.titleAr is string && data.titleAr.size() >= 2 && data.titleAr.size() <= 120
      && data.description is string && data.description.size() >= 4 && data.description.size() <= 400
      && data.url is string && data.url.size() >= 8 && data.url.size() <= 500
      && data.url.matches('^https?://.+')
      && data.category in ['lean', 'quality', 'production', 'training', 'ai', 'other']
      && data.iconType in ['lucide', 'image']
      && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 60
      && data.iconUrl is string && data.iconUrl.size() <= 1000
      && data.accentColor in ['red', 'blue', 'emerald', 'amber', 'indigo', 'rose', 'slate']
      && data.order is int && data.order >= 0 && data.order <= 10000
      && data.isActive is bool
      && data.featured is bool
      && isValidId(data.createdBy)
      && data.createdBy.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'employeeCode', 'phone', 'jobTitle', 'company',
        'photoURL', 'role', 'approvalStatus', 'profileCompleted',
        'notificationsEnabled', 'platformInfo', 'totalLaunches',
        'lastActiveAt', 'createdAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'employeeCode', 'phone', 'jobTitle', 'company',
        'photoURL', 'role', 'approvalStatus', 'profileCompleted',
        'notificationsEnabled', 'platformInfo', 'totalLaunches', 'totalDurationSeconds',
        'adminNotes', 'customFields', 'lastActiveAt', 'createdAt'
      ])
      && isValidId(data.uid)
      && data.uid.size() <= 128
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
      && data.employeeCode is string && data.employeeCode.size() <= 30
      && data.phone is string && data.phone.size() <= 30
      && data.jobTitle is string && data.jobTitle.size() <= 100
      && data.company is string && data.company.size() <= 100
      && data.photoURL is string && data.photoURL.size() <= 500
      && data.role in ['user', 'admin']
      && data.approvalStatus in ['pending', 'approved', 'rejected']
      && data.profileCompleted is bool
      && (
        data.profileCompleted == false || (
          data.displayName.size() >= 2
          && data.employeeCode.size() >= 1
          && data.phone.size() >= 8
          && data.jobTitle.size() >= 2
          && data.company.size() >= 2
        )
      )
      && data.notificationsEnabled is bool
      && data.platformInfo is string && data.platformInfo.size() <= 100
      && data.totalLaunches is int && data.totalLaunches >= 0 && data.totalLaunches <= 10000000
      && (!('totalDurationSeconds' in data) || (data.totalDurationSeconds is int && data.totalDurationSeconds >= 0 && data.totalDurationSeconds <= 100000000))
      && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
      && (!('customFields' in data) || (data.customFields is map && data.customFields.size() <= 25))
      && data.lastActiveAt is timestamp
      && data.createdAt is timestamp;
    }

    function isValidInvitedUser(data) {
      return data.keys().hasAll([
        'id', 'email', 'displayName', 'employeeCode', 'phone', 'jobTitle', 'company',
        'role', 'approvalStatus', 'adminNotes', 'customFields', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'email', 'displayName', 'employeeCode', 'phone', 'jobTitle', 'company',
        'role', 'approvalStatus', 'adminNotes', 'customFields', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.id.size() >= 3
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
      && data.employeeCode is string && data.employeeCode.size() <= 30
      && data.phone is string && data.phone.size() <= 30
      && data.jobTitle is string && data.jobTitle.size() <= 100
      && data.company is string && data.company.size() <= 100
      && data.role in ['user', 'admin']
      && data.approvalStatus in ['pending', 'approved', 'rejected']
      && data.adminNotes is string && data.adminNotes.size() <= 1000
      && data.customFields is map && data.customFields.size() <= 25
      && isValidId(data.createdBy)
      && data.createdBy.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidReadReceipt(data) {
      return data.keys().hasAll(['notificationId', 'readAt'])
      && data.keys().hasOnly(['notificationId', 'readAt'])
      && isValidId(data.notificationId)
      && data.notificationId.size() <= 64
      && data.readAt is timestamp;
    }

    function isValidBroadcastNotification(data) {
      return data.keys().hasAll([
        'id', 'title', 'body', 'type', 'targetAppUrl',
        'targetAppTitle', 'senderName', 'isActive', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'title', 'body', 'type', 'targetAppUrl',
        'targetAppTitle', 'senderName', 'isActive', 'createdAt'
      ])
      && isValidId(data.id)
      && data.id.size() >= 2 && data.id.size() <= 64
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
      && data.body is string && data.body.size() >= 2 && data.body.size() <= 1000
      && data.type in ['announcement', 'new_app', 'update', 'urgent']
      && data.targetAppUrl is string && data.targetAppUrl.size() <= 500
      && data.targetAppTitle is string && data.targetAppTitle.size() <= 100
      && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100
      && data.isActive is bool
      && data.createdAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
        'userId', 'userEmail', 'userName', 'appId',
        'appTitle', 'deviceType', 'createdAt'
      ])
      && data.keys().hasOnly([
        'userId', 'userEmail', 'userName', 'appId',
        'appTitle', 'deviceType', 'action', 'details',
        'durationSeconds', 'sessionStatus', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.userId)
      && data.userId.size() <= 128
      && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 150
      && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
      && isValidId(data.appId)
      && data.appId.size() <= 64
      && data.appTitle is string && data.appTitle.size() >= 1 && data.appTitle.size() <= 100
      && data.deviceType is string && data.deviceType.size() >= 1 && data.deviceType.size() <= 60
      && (!('action' in data) || data.action in ['launch', 'embedded_launch', 'copy_link', 'profile_update', 'notification_read'])
      && (!('details' in data) || (data.details is string && data.details.size() <= 300))
      && (!('durationSeconds' in data) || (data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 28800))
      && (!('sessionStatus' in data) || data.sessionStatus in ['active', 'completed', 'instant'])
      && data.createdAt is timestamp
      && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // 1. Applications Catalog (/apps/{appId}) - Locked Behind Auth & Admin Approval
    match /apps/{appId} {
      allow get: if isValidId(appId) && appId.size() <= 64 && isApprovedUser() && (resource.data.isActive == true || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.isActive == true || isBootstrappedAdmin());

      allow create: if isAdmin()
        && isValidId(appId)
        && appId.size() <= 64
        && isValidAppItem(incoming())
        && incoming().id == appId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(appId)
        && appId.size() <= 64
        && isValidAppItem(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'titleAr', 'description', 'url', 'category',
          'iconType', 'iconName', 'iconUrl', 'accentColor', 'order',
          'isActive', 'featured', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(appId) && appId.size() <= 64;
    }

    // 2. Users Collection (/users/{userId}) - Strict PII Isolation & Admin Control
    match /users/{userId} {
      allow get: if isValidId(userId) && userId.size() <= 128 && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isOwner(userId)
        && isValidId(userId)
        && userId.size() <= 128
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().totalLaunches == 0
        && (!('totalDurationSeconds' in incoming()) || incoming().totalDurationSeconds == 0)
        && incoming().createdAt == request.time
        && incoming().lastActiveAt == request.time
        && (
          isBootstrappedAdmin()
          || (
            hasInvitedRecord()
            && incoming().role == invitedRecordData().role
            && incoming().approvalStatus == invitedRecordData().approvalStatus
            && (!('adminNotes' in incoming()) || incoming().adminNotes == invitedRecordData().adminNotes)
            && (!('customFields' in incoming()) || incoming().customFields == invitedRecordData().customFields)
          )
          || (
            incoming().role == 'user'
            && incoming().approvalStatus == 'pending'
            && (!('adminNotes' in incoming()) || incoming().adminNotes == '')
            && (!('customFields' in incoming()) || incoming().customFields.size() == 0)
          )
        );

      allow update: if isValidId(userId)
        && userId.size() <= 128
        && isVerifiedUser()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().lastActiveAt == request.time
        && (
          // Tier 1: Admin can edit all profile fields, notes, customFields, role, and approvalStatus
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'employeeCode', 'phone', 'jobTitle', 'company', 'photoURL',
            'role', 'approvalStatus', 'profileCompleted', 'notificationsEnabled',
            'platformInfo', 'totalLaunches', 'totalDurationSeconds',
            'adminNotes', 'customFields', 'lastActiveAt'
          ]))
          ||
          // Tier 2: Owner can update their own standard profile OR increment usage stats
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().email == existing().email
            && (
              (!('approvalStatus' in existing()) && incoming().approvalStatus == 'pending')
              || (('approvalStatus' in existing()) && incoming().approvalStatus == existing().approvalStatus)
            )
            && (
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'employeeCode', 'phone', 'jobTitle', 'company', 'photoURL',
                'approvalStatus', 'profileCompleted', 'notificationsEnabled',
                'platformInfo', 'lastActiveAt'
              ]))
              ||
              (isApprovedUser()
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'totalLaunches', 'totalDurationSeconds', 'platformInfo', 'lastActiveAt'
                ])
                && (!('totalLaunches' in incoming().diff(existing()).affectedKeys()) || incoming().totalLaunches == existing().totalLaunches + 1)
                && (!('totalDurationSeconds' in incoming().diff(existing()).affectedKeys()) || (
                  (!('totalDurationSeconds' in existing()) && incoming().totalDurationSeconds >= 0 && incoming().totalDurationSeconds <= 28800)
                  || (('totalDurationSeconds' in existing()) && incoming().totalDurationSeconds >= existing().totalDurationSeconds && incoming().totalDurationSeconds <= existing().totalDurationSeconds + 28800)
                ))
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId) && userId.size() <= 128;

      // Master Gate Subcollection: Read Notification Receipts
      match /readNotifications/{notificationId} {
        allow get: if isValidId(userId) && userId.size() <= 128 && isValidId(notificationId) && notificationId.size() <= 64
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isValidId(userId) && userId.size() <= 128
          && (isOwner(userId) || isBootstrappedAdmin());

        allow create: if isValidId(userId) && userId.size() <= 128 && isValidId(notificationId) && notificationId.size() <= 64
          && isOwner(userId)
          && isApprovedUser()
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidReadReceipt(incoming())
          && incoming().notificationId == notificationId
          && incoming().readAt == request.time;

        allow update: if false;
        allow delete: if isValidId(userId) && userId.size() <= 128 && isValidId(notificationId) && notificationId.size() <= 64 && (isOwner(userId) || isAdmin());
      }
    }

    // 2b. Pre-registered / Invited Users (/invitedUsers/{emailKey})
    match /invitedUsers/{emailKey} {
      allow get: if isValidId(emailKey) && (
        isAdmin()
        || (isVerifiedUser() && ('email' in request.auth.token) && emailKey == callerEmailKey())
      );
      allow list: if isBootstrappedAdmin();

      allow create: if isAdmin()
        && isValidId(emailKey)
        && emailKey.size() >= 3
        && isValidInvitedUser(incoming())
        && incoming().id == emailKey
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(emailKey)
        && emailKey.size() >= 3
        && isValidInvitedUser(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'displayName', 'employeeCode', 'phone', 'jobTitle', 'company',
          'role', 'approvalStatus', 'adminNotes', 'customFields', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(emailKey);
    }

    // 3. Broadcast Notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && notificationId.size() <= 64 && isApprovedUser() && (resource.data.isActive == true || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.isActive == true || isBootstrappedAdmin());

      allow create: if isAdmin()
        && isValidId(notificationId)
        && notificationId.size() <= 64
        && isValidBroadcastNotification(incoming())
        && incoming().id == notificationId
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(notificationId)
        && notificationId.size() <= 64
        && isValidBroadcastNotification(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'body', 'type', 'targetAppUrl', 'targetAppTitle', 'isActive'
        ]);

      allow delete: if isAdmin() && isValidId(notificationId) && notificationId.size() <= 64;
    }

    // 4. Activity Logs (/activityLogs/{logId})
    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && logId.size() <= 128 && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isApprovedUser()
        && isValidId(logId)
        && logId.size() <= 128
        && isValidActivityLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      allow update: if isValidId(logId)
        && logId.size() <= 128
        && isApprovedUser()
        && isValidActivityLog(incoming())
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().userName == existing().userName
        && incoming().appId == existing().appId
        && incoming().appTitle == existing().appTitle
        && incoming().deviceType == existing().deviceType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'durationSeconds', 'sessionStatus', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(logId) && logId.size() <= 128;
    }

    // 5. Admins Registry (/admins/{adminId})
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && adminId.size() <= 128 && isVerifiedUser() && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
